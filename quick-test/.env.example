# Server
PORT=4000

# Static bearer token — required when set; landing-page /api/scan sends this header
SCANNER_API_TOKEN=change-me-to-a-long-random-string

# Optional — raises GitHub API rate limit from 60/hr to 5000/hr
GITHUB_TOKEN=

# Max repo size (MB) before rejecting scan
MAX_REPO_SIZE_MB=200

# Scan timeout per tool (seconds)
SCAN_TIMEOUT_SECONDS=120

# Max findings returned in public API response (default 10)
PUBLIC_FINDINGS_LIMIT=10
