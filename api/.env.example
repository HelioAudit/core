# Server (in-container / local process listen port)
PORT=3001

# Host port when using docker compose (maps HOST_PORT -> container 3001)
HOST_PORT=3001

# Static bearer token — required when set; clients must send Authorization: Bearer <token>
SCANNER_API_TOKEN=change-me-to-a-long-random-string

# Optional — raises GitHub API rate limit from 60/hr to 5000/hr
GITHUB_TOKEN=

# Max repo size (MB) before rejecting scan
MAX_REPO_SIZE_MB=200

# Scan timeout per tool (seconds)
SCAN_TIMEOUT_SECONDS=120

# Max findings returned in public API response (default 10)
PUBLIC_FINDINGS_LIMIT=10

# Set true to run npm install before audit (slower, more accurate for transitive deps)
SCAN_NPM_INSTALL=false

# Set to debug for verbose server logs
LOG_LEVEL=
